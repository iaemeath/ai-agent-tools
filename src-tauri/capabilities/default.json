{
  "$schema": "https://schema.tauri.app/config/2/capabilities",
  "identifier": "default",
  "description": "Capabilities for Claude Tool Manager",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "dialog:allow-open"
  ]
}
