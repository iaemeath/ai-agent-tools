{
  "name": "ccc-ui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Manage Claude Code skills and plugins (Config-as-SSOT). Node + Hono + Vue 3 + Element Plus.",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "npm -w web run dev",
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "build": "npm -w web run build",
    "start": "tsx server/src/index.ts",
    "typecheck": "npm -w server exec tsc --noEmit && npm -w web exec vue-tsc --noEmit"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
